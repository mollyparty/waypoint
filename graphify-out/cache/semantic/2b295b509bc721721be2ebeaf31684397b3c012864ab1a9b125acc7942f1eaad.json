{"nodes": [{"id": "dec001_trunk_versioning", "label": "DEC-001: Trunk-based versioning on main", "file_type": "document", "source_file": "vault/02-Decisions/DEC-001 Trunk-based versioning on main.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One branch to trust satisfies the 'latest approved version' requirement; lower overhead than GitFlow for a solo founder with no long-lived develop branch to drift; tags plus changelog give named, auditable milestones without ceremony. GitFlow and main-only/commit-direct were both considered and rejected. Amended by DEC-004 (2026-07-30): push cadence changed from session-end-only to continuous; everything else in the decision stands."}], "edges": [{"source": "dec001_trunk_versioning", "target": "docs_versioning_strategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/02-Decisions/DEC-001 Trunk-based versioning on main.md", "source_location": null, "weight": 1.0}, {"source": "dec001_trunk_versioning", "target": "decision_log_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/02-Decisions/DEC-001 Trunk-based versioning on main.md", "source_location": null, "weight": 1.0}, {"source": "dec001_trunk_versioning", "target": "versioning_conventional_commits", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/02-Decisions/DEC-001 Trunk-based versioning on main.md", "source_location": null, "weight": 1.0}, {"source": "dec001_trunk_versioning", "target": "versioning_attribution_footer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/02-Decisions/DEC-001 Trunk-based versioning on main.md", "source_location": null, "weight": 1.0}], "hyperedges": []}